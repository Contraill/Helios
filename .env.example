# Server-only key for current APOD, DONKI and NeoWs responses.
# The application remains usable with verified snapshots when omitted locally.
# Required for the production provider release probe.
# NASA_API_KEY=

# Canonical production origin used by metadata, sitemap and robots.
# Must be an origin only: no path, query or hash.
# SITE_URL=https://heliios.vercel.app
